#pragma kernel SobelEdgeDetection

// Входная текстура маски сегментации
Texture2D<float> InputTexture;

// Выходная текстура с краями
RWTexture2D<float> EdgeTexture;

// Параметры
float EdgeThreshold;
int KernelSize;

// Размеры текстуры
uint2 TextureSize;

// Ядра Собеля для обнаружения краев
static const int3x3 SobelX = {
    -1, 0, 1,
    -2, 0, 2,
    -1, 0, 1
};

static const int3x3 SobelY = {
    -1, -2, -1,
     0,  0,  0,
     1,  2,  1
};

[numthreads(8, 8, 1)]
void SobelEdgeDetection(uint3 id : SV_DispatchThreadID)
{
    // Проверяем границы текстуры
    uint2 texSize;
    InputTexture.GetDimensions(texSize.x, texSize.y);
    
    if (id.x >= texSize.x || id.y >= texSize.y)
        return;
    
    // Пропускаем пиксели на границах
    if (id.x < 1 || id.x >= texSize.x - 1 || id.y < 1 || id.y >= texSize.y - 1)
    {
        EdgeTexture[id.xy] = 0.0;
        return;
    }
    
    // Вычисляем градиенты по X и Y
    float gx = 0.0;
    float gy = 0.0;
    
    // Применяем ядра Собеля
    [unroll]
    for (int dy = -1; dy <= 1; dy++)
    {
        [unroll]
        for (int dx = -1; dx <= 1; dx++)
        {
            uint2 samplePos = uint2(id.x + dx, id.y + dy);
            float pixelValue = InputTexture[samplePos].r; // Используем только красный канал
            
            // Индексы для ядер (смещение +1 для 0-2 диапазона)
            int kx = dx + 1;
            int ky = dy + 1;
            
            // Применяем ядра Собеля
            if (kx == 0 && ky == 0) // -1, -1
                { gx += pixelValue * SobelX[0][0]; gy += pixelValue * SobelY[0][0]; }
            else if (kx == 1 && ky == 0) // 0, -1
                { gx += pixelValue * SobelX[0][1]; gy += pixelValue * SobelY[0][1]; }
            else if (kx == 2 && ky == 0) // 1, -1
                { gx += pixelValue * SobelX[0][2]; gy += pixelValue * SobelY[0][2]; }
            else if (kx == 0 && ky == 1) // -1, 0
                { gx += pixelValue * SobelX[1][0]; gy += pixelValue * SobelY[1][0]; }
            else if (kx == 1 && ky == 1) // 0, 0
                { gx += pixelValue * SobelX[1][1]; gy += pixelValue * SobelY[1][1]; }
            else if (kx == 2 && ky == 1) // 1, 0
                { gx += pixelValue * SobelX[1][2]; gy += pixelValue * SobelY[1][2]; }
            else if (kx == 0 && ky == 2) // -1, 1
                { gx += pixelValue * SobelX[2][0]; gy += pixelValue * SobelY[2][0]; }
            else if (kx == 1 && ky == 2) // 0, 1
                { gx += pixelValue * SobelX[2][1]; gy += pixelValue * SobelY[2][1]; }
            else if (kx == 2 && ky == 2) // 1, 1
                { gx += pixelValue * SobelX[2][2]; gy += pixelValue * SobelY[2][2]; }
        }
    }
    
    // Вычисляем магнитуду градиента
    float magnitude = sqrt(gx * gx + gy * gy);
    
    // Применяем порог
    float edgeValue = magnitude > EdgeThreshold ? magnitude : 0.0;
    
    // Записываем результат
    EdgeTexture[id.xy] = edgeValue;
}

// Дополнительное ядро для обнаружения углов (метод Харриса)
#pragma kernel HarrisCornerDetection

RWTexture2D<float> CornerTexture;
float CornerThreshold;

[numthreads(8, 8, 1)]
void HarrisCornerDetection(uint3 id : SV_DispatchThreadID)
{
    uint2 texSize;
    EdgeTexture.GetDimensions(texSize.x, texSize.y);
    
    if (id.x >= texSize.x || id.y >= texSize.y)
        return;
    
    // Пропускаем пиксели на границах (нужна окрестность 3x3)
    if (id.x < 2 || id.x >= texSize.x - 2 || id.y < 2 || id.y >= texSize.y - 2)
    {
        CornerTexture[id.xy] = 0.0;
        return;
    }
    
    // Вычисляем компоненты структурного тензора
    float Ixx = 0.0, Iyy = 0.0, Ixy = 0.0;
    
    // Окрестность 3x3 для анализа углов
    [unroll]
    for (int dy = -1; dy <= 1; dy++)
    {
        [unroll]
        for (int dx = -1; dx <= 1; dx++)
        {
            uint2 samplePos = uint2(id.x + dx, id.y + dy);
            float intensity = EdgeTexture[samplePos].r;
            
            // Для упрощения используем интенсивность краев как градиент
            Ixx += intensity * intensity;
            Iyy += intensity * intensity;
            Ixy += intensity * intensity * 0.5; // Упрощенное перекрестное произведение
        }
    }
    
    // Вычисляем ответ детектора углов Харриса
    float det = Ixx * Iyy - Ixy * Ixy;
    float trace = Ixx + Iyy;
    float k = 0.04; // Константа Харриса
    
    float harrisResponse = det - k * trace * trace;
    
    // Применяем порог для углов
    float cornerValue = harrisResponse > CornerThreshold ? harrisResponse : 0.0;
    
    CornerTexture[id.xy] = cornerValue;
}

// Ядро для комбинирования краев и углов в одной текстуре
#pragma kernel CombineEdgesAndCorners

RWTexture2D<float4> CombinedTexture; // RGBA: R=edges, G=corners, B=walls, A=opacity

[numthreads(8, 8, 1)]
void CombineEdgesAndCorners(uint3 id : SV_DispatchThreadID)
{
    uint2 texSize;
    EdgeTexture.GetDimensions(texSize.x, texSize.y);
    
    if (id.x >= texSize.x || id.y >= texSize.y)
        return;
    
    // Получаем значения
    float edgeValue = EdgeTexture[id.xy].r;
    float cornerValue = CornerTexture[id.xy].r;
    float wallValue = InputTexture[id.xy].r; // Исходная маска стен
    
    // Комбинируем в RGBA
    float4 combined;
    combined.r = edgeValue;      // Красный канал = края
    combined.g = cornerValue;    // Зеленый канал = углы  
    combined.b = wallValue;      // Синий канал = стены
    combined.a = max(max(edgeValue, cornerValue), wallValue * 0.3); // Прозрачность
    
    CombinedTexture[id.xy] = combined;
}

